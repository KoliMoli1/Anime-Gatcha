local Players=game:GetService('Players'); local RS=game:GetService('ReplicatedStorage'); local remote=RS:WaitForChild('GenerateRandomNumber'); local rem=RS:WaitForChild('AnimeCombatCore'):WaitForChild('Remotes'); local getCollection=rem:WaitForChild('GetCollectionSnapshot'); local collectionUpdated=rem:WaitForChild('CollectionUpdated'); local rng=Random.new(); local STARTING_COINS=100; local ROLL_COST=10; local COLLECTION_RULES={} -- Add qualifying roll values here later, for example {[777]=true,[1000]=true}
local collections={}
local function qualifies(value) return COLLECTION_RULES[value]==true end
local function snapshot(player) local list=collections[player] or {}; local result={}; for i,item in ipairs(list) do result[i]={Value=item.Value,Count=item.Count} end; return result end
Players.PlayerAdded:Connect(function(player) local leaderstats=Instance.new('Folder'); leaderstats.Name='leaderstats'; leaderstats.Parent=player; local coins=Instance.new('IntValue'); coins.Name='Coins'; coins.Value=STARTING_COINS; coins.Parent=leaderstats; collections[player]={} end)
Players.PlayerRemoving:Connect(function(player) collections[player]=nil end)
getCollection.OnServerInvoke=function(player) return snapshot(player) end
remote.OnServerInvoke=function(player) local stats=player:FindFirstChild('leaderstats'); local coins=stats and stats:FindFirstChild('Coins'); if not coins then return {success=false,message='Currency is still loading.'} end; if coins.Value<ROLL_COST then return {success=false,message='Not enough coins!',coins=coins.Value,cost=ROLL_COST} end; coins.Value-=ROLL_COST; local number=rng:NextInteger(1,1000); local added=false; if qualifies(number) then local list=collections[player] or {}; local found; for _,item in ipairs(list) do if item.Value==number then found=item break end end; if found then found.Count+=1 else table.insert(list,{Value=number,Count=1}) end; collections[player]=list; added=true; collectionUpdated:FireClient(player,snapshot(player)) end; print(string.format('[AnimeGacha] %s rolled %d for %d coins (%d remaining)',player.Name,number,ROLL_COST,coins.Value)); return {success=true,value=number,coins=coins.Value,cost=ROLL_COST,collectionAdded=added} end