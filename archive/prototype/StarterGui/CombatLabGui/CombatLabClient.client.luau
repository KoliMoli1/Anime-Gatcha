local RS=game:GetService('ReplicatedStorage'); local gui=script.Parent; local p=gui.Panel; local c=p.Content; local sv=c.StatsView; local bv=c.BattleView; local arena=bv.Arena; local logPanel=bv.LogPanel; local nav=p.Nav; local rf=RS.AnimeCombatCore.Remotes.GetCombatLabSnapshot; local snap=rf:InvokeServer({Action='ResetBattle'}); local chosenActions={Player={},Enemy={}}
local function view(v) sv.Visible=false; bv.Visible=true end
local function action2Name(class) if class=='Attack' then return 'DAMAGE UP' elseif class=='Defense' then return 'TAUNT' elseif class=='Support' then return 'CRIT BUFF' elseif class=='Disrupt' then return 'SABOTAGE' elseif class=='Speed' then return 'OVERCLOCK' else return 'CLASS SKILL' end end
local function makeEnergy(side,x)
 local bar=arena:FindFirstChild(side..'EnergyBar'); if not bar then bar=Instance.new('Frame'); bar.Name=side..'EnergyBar'; bar.Parent=arena; bar.BackgroundColor3=Color3.fromRGB(25,35,55); bar.BorderSizePixel=0; bar.Size=UDim2.fromOffset(330,26); bar.Position=UDim2.fromOffset(x,48); bar.ZIndex=4; local fill=Instance.new('Frame'); fill.Name='Fill'; fill.Parent=bar; fill.BackgroundColor3=side=='Player' and Color3.fromRGB(65,160,255) or Color3.fromRGB(235,100,90); fill.BorderSizePixel=0; fill.Size=UDim2.fromScale(0,1); fill.ZIndex=5; local text=Instance.new('TextLabel'); text.Name='Text'; text.Parent=bar; text.BackgroundTransparency=1; text.Size=UDim2.fromScale(1,1); text.Font=Enum.Font.GothamBold; text.TextSize=13; text.TextColor3=Color3.new(1,1,1); text.ZIndex=6 end; return bar end
local playerEnergy=makeEnergy('Player',10); local enemyEnergy=makeEnergy('Enemy',395)
local costPopup=arena:FindFirstChild('EnergyCostPopup'); if not costPopup then costPopup=Instance.new('TextLabel'); costPopup.Name='EnergyCostPopup'; costPopup.Parent=arena; costPopup.BackgroundColor3=Color3.fromRGB(20,28,45); costPopup.BorderSizePixel=0; costPopup.Size=UDim2.fromOffset(145,34); costPopup.Font=Enum.Font.GothamBold; costPopup.TextSize=12; costPopup.TextColor3=Color3.fromRGB(255,225,100); costPopup.TextWrapped=true; costPopup.Visible=false; costPopup.ZIndex=20 end
local function team(side,i) return side=='Player' and snap.PlayerTeam[i] or snap.EnemyTeam[i] end
local function renderEnergy()
 local e=snap.Energy or {Player=0,Enemy=0,Max=300,PlayerGain=0,EnemyGain=0}; for _,q in ipairs({{playerEnergy,'Player'},{enemyEnergy,'Enemy'}}) do local bar,side=q[1],q[2]; local value=e[side] or 0; local gain=e[side..'Gain'] or 0; bar.Fill.Size=UDim2.fromScale(math.clamp(value/(e.Max or 300),0,1),1); bar.Text.Text=string.upper(side)..' ENERGY  '..value..' / '..(e.Max or 300)..'   (+ '..gain..' / turn)' end end
local function renderSide(side) for i=1,3 do local s=team(side,i); local target=side=='Player' and 'E'..s.Target or 'P'..s.Target; arena[side..'Name'..i].Text=(side=='Player' and 'P' or 'E')..i..' • '..s.Name; arena[side..'Target'..i].Text='TARGET: '..target; local bar=arena:FindFirstChild(side..'HpBar'..i); bar.Fill.Size=UDim2.fromScale(math.clamp(s.HP/s.Stats.MaxHealth,0,1),1); bar.Text.Text=string.format('%d / %d',s.HP,s.Stats.MaxHealth); local class=s.Class or 'Unknown'; local actionName=action2Name(class); local chosen=chosenActions[side][i]; local effect=s.Effects or {}; local hue=effect.Disrupted and Color3.fromRGB(220,100,125) or effect.Haste and Color3.fromRGB(80,220,235) or (effect.SupportBuff and class=='Support') and Color3.fromRGB(170,90,210) or (effect.DefenseBuff and class=='Defense' and Color3.fromRGB(70,190,95) or Color3.fromRGB(255,255,255)); arena[side..'Name'..i].TextColor3=hue; local empowered=effect.AttackBuff and class=='Attack'; local classTint=(effect.SupportBuff and class=='Support') and Color3.fromRGB(120,55,150) or (effect.DefenseBuff and Color3.fromRGB(40,145,65) or nil); for _,k in ipairs({'Attack','Action2'}) do local b=arena:FindFirstChild(side..k..i); if k=='Action2' then b.Text=actionName end; local chosenHere=chosen==k; local glow=b:FindFirstChild('SelectedActionGlow') or Instance.new('UIStroke'); glow.Name='SelectedActionGlow'; glow.Parent=b; glow.Enabled=chosenHere; glow.Color=Color3.fromRGB(255,220,70); glow.Thickness=chosenHere and 3 or 0; if classTint then b.BackgroundColor3=classTint; b.TextColor3=Color3.fromRGB(255,255,255) elseif empowered then b.BackgroundColor3=Color3.fromRGB(105,28,35); b.TextColor3=Color3.fromRGB(255,235,235) else b.BackgroundColor3=chosenHere and Color3.fromRGB(220,175,45) or Color3.fromRGB(40,52,75); b.TextColor3=Color3.fromRGB(255,255,255) end end end end
local function battle()
 local rosterNames={}; for i,x in ipairs(snap.PlayerTeam or {}) do rosterNames[i]=x.Name end
 arena.TurnText.Text='TURN '..snap.Battle.TurnNumber..' • YOUR TEAM: '..table.concat(rosterNames,' / ')
 renderEnergy(); renderSide('Player'); renderSide('Enemy')
 if snap.Battle.Finished then
  logPanel.Status.Text=(snap.Battle.Winner=='Player' and 'VICTORY!' or snap.Battle.Winner=='Enemy' and 'DEFEAT' or 'DRAW')..' — press Reset Battle to play again.'
 elseif snap.CanBattle then
  logPanel.Status.Text=snap.CanResolve and 'All living character actions selected. Resolve the speed-ordered turn.' or 'Choose Attack or Action 2 for every living character.'
 else
  logPanel.Status.Text='TEAM SELECT REQUIRED: '..(snap.TeamStatus or 'Save three owned characters before battling.')
 end
 logPanel.LogText.Text=table.concat(snap.Battle.Log,'\n')
end
local function refresh(r) snap=rf:InvokeServer(r); battle() end
for i=1,3 do
 arena['PlayerTargetPrev'..i].Activated:Connect(function() refresh({Action='SelectTarget',Side='Player',Slot=i,Direction=-1}) end)
