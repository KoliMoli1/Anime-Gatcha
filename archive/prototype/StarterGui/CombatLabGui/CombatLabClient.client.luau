 arena['PlayerAction2'..i].Activated:Connect(function() local unit=team('Player',i); costPopup.Text=action2Name(unit.Class)..' cost: '..tostring(unit.Action2Cost or 100)..' energy'; local b=arena['PlayerAction2'..i]; costPopup.Position=UDim2.fromOffset(b.Position.X.Offset+b.Size.X.Offset+8,b.Position.Y.Offset); costPopup.Visible=true; chosenActions.Player[i]='Action2'; refresh({Action='SetAction',Side='Player',Slot=i,Kind='Action2'}) end)
 for _,name in ipairs({'EnemyAttack','EnemyAction2','EnemyTargetPrev','EnemyTargetNext','EnemyPrev','EnemyNext'}) do local button=arena:FindFirstChild(name..i); if button and button:IsA('GuiButton') then button.Active=false; button.AutoButtonColor=false end end
end
for i=1,3 do arena['PlayerPrev'..i].Visible=false; arena['PlayerNext'..i].Visible=false end
arena.ResolveButton.Activated:Connect(function() for i=1,3 do local unit=team('Player',i); if unit.HP>0 and not chosenActions.Player[i] then logPanel.Status.Text='Choose Attack or Action 2 for P'..i..' before resolving the turn.'; return end end; chosenActions={Player={},Enemy={}}; costPopup.Visible=false; refresh({Action='ResolveTurn'}) end)
arena.ResetButton.Activated:Connect(function() chosenActions={Player={},Enemy={}}; costPopup.Visible=false; refresh({Action='ResetBattle'}) end)
nav.InspectButton.Visible=false; nav.BattleButton.Visible=true; view('b'); battle()
