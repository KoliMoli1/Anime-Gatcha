local RS=game:GetService('ReplicatedStorage'); local UIS=game:GetService('UserInputService'); local gui=script.Parent; local panel=gui:WaitForChild('Panel'); local header=panel:WaitForChild('Header'); local body=panel:WaitForChild('Body'); local close=panel:WaitForChild('CloseButton'); local toggle=gui:WaitForChild('ToggleIcon'); local rem=RS:WaitForChild('AnimeCombatCore'):WaitForChild('Remotes'); local get=rem:WaitForChild('GetCollectionSnapshot'); local updated=rem:WaitForChild('CollectionUpdated'); local dragging=false; local dragStart; local panelStart; local dragInput
local function render(items) if not items or #items==0 then body.Text='COLLECTION READY\n\nQualifying gacha rolls will appear here.\nRoll-value rules are intentionally pending configuration.'; return end; local lines={'CHARACTER COLLECTION',''}; for _,item in ipairs(items) do table.insert(lines,string.format('%s [%s]   ×%d',item.DisplayName or item.Id or 'Unknown',item.Class or 'Unknown',item.Count or 0)) end; body.Text=table.concat(lines,'\n') end
local function moveToggle() toggle.Position=UDim2.new(0,20,1,-90) end
header.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=true; dragStart=input.Position; panelStart=panel.Position; input.Changed:Connect(function() if input.UserInputState==Enum.UserInputState.End then dragging=false end end) end end)
header.InputChanged:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then dragInput=input end end)
UIS.InputChanged:Connect(function(input) if dragging and input==dragInput then local d=input.Position-dragStart; panel.Position=UDim2.new(panelStart.X.Scale,panelStart.X.Offset+d.X,panelStart.Y.Scale,panelStart.Y.Offset+d.Y); moveToggle() end end)
close.Activated:Connect(function() moveToggle(); panel.Visible=false; toggle.Visible=true end); toggle.Activated:Connect(function() panel.Visible=true; toggle.Visible=false end); updated.OnClientEvent:Connect(render); panel.Visible=false; toggle.Visible=true; render(get:InvokeServer()); moveToggle()